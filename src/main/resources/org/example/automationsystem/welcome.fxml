<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.automationsystem.WelcomeController"
      alignment="CENTER" spacing="20" prefWidth="600" prefHeight="400">

    <Text text="Automated Text Processing Tool">
        <font>
            <Font size="24"/>
        </font>
    </Text>

    <Text wrappingWidth="500" text="Welcome! This tool helps you perform advanced text processing operations including regular expression matching, replacement, keyword recognition, and frequency analysis." />

    <Button text="Get Started" onAction="#onContinue"/>

    <padding>
        <Insets top="50" bottom="50" left="50" right="50"/>
    </padding>
</VBox>
